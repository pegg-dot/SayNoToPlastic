# Public origin used for canonical links, email preferences, checkout, and recovery.
# Keep this on the movement domain. The legacy WooCommerce checkout URL is configured separately in app/config.ts.
PUBLIC_SITE_URL=https://saynotoplastic.com
NEXT_PUBLIC_SITE_URL=https://saynotoplastic.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@saynotoplastic.com

# Safe default. Use `preview` only with COMMERCE_PREVIEW_ENABLED=true in local/staging review.
# Switch to `stripe` only after COMMERCE_SETUP.md is complete.
COMMERCE_MODE=woocommerce
COMMERCE_PREVIEW_ENABLED=false

# Stripe server-only configuration. Never commit populated secret values.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_API_VERSION=2026-07-29.dahlia
STRIPE_AUTOMATIC_TAX=false

# Private ebook delivery. The PDF belongs in the private EBOOKS R2 binding, never public/.
EBOOK_ACCESS_SECRET=
EBOOK_OBJECT_KEY=ebooks/homo-plasticus.pdf
EBOOK_DOWNLOAD_FILENAME=Homo-Plasticus.pdf
EBOOK_SHA256=

# Transactional email provider. Used for welcome messages, requested learning-series lessons, contact notifications, and ebook access.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Say No to Plastic <updates@saynotoplastic.com>
SUPPORT_EMAIL=support@saynotoplastic.com

# Newsletter/audience provider is an explicit owner decision.
# Allowed values: none, resend, mailchimp. Keep `none` until an owner approves and configures one provider.
AUDIENCE_PROVIDER=none
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_AUDIENCE_ID=

# Protects internal readiness and email-outbox drain endpoints. Use 32+ random characters.
# A trusted server-side scheduler must POST to /api/internal/email-outbox; see docs/LEARNING_SERIES_OPERATIONS.md.
OPERATIONS_SECRET=
