{
  "name": "homo-plasticus",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "prepare:podcast-artwork": "node scripts/prepare-podcast-artwork.mjs",
    "predev": "npm run prepare:podcast-artwork",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "prebuild": "npm run prepare:podcast-artwork",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "source:audit": "node scripts/source-audit.mjs",
    "links:audit": "node scripts/link-audit.mjs",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "commerce:preflight": "node scripts/commerce-preflight.mjs",
    "affiliate:preflight": "node scripts/affiliate-preflight.mjs",
    "dev:commerce-preview": "COMMERCE_MODE=preview COMMERCE_PREVIEW_ENABLED=true PUBLIC_SITE_URL=http://localhost:5173 WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "syntax:audit": "node scripts/syntax-audit.mjs",
    "ui:audit": "node scripts/ui-readiness-audit.mjs",
    "clarity:audit": "node scripts/clarity-audit.mjs",
    "operations:audit": "node scripts/operations-audit.mjs",
    "media:preflight": "node scripts/media-preflight.mjs",
    "audience:preflight": "node scripts/audience-preflight.mjs",
    "transcript:priority": "node scripts/transcript-priority-audit.mjs",
    "audience:test": "node --experimental-strip-types scripts/audience-adapter-test.mjs",
    "learning-series:test": "node --experimental-strip-types scripts/learning-series-contract-test.mjs",
    "content:preflight": "node scripts/content-intake-audit.mjs",
    "content:integration": "node --experimental-strip-types scripts/haddad-content-integration-audit.mjs",
    "transcript:complete": "node scripts/nothing-left-behind-audit.mjs",
    "homepage:polish": "node scripts/homepage-polish-audit.mjs",
    "local:preflight": "node scripts/local-portability-audit.mjs",
    "science:polish": "node scripts/science-polish-audit.mjs",
    "solutions:polish": "node scripts/solutions-polish-audit.mjs",
    "guides:polish": "node scripts/guides-polish-audit.mjs",
    "book-about:polish": "node scripts/book-about-polish-audit.mjs",
    "media-community:polish": "node scripts/media-community-polish-audit.mjs",
    "welcome:film": "node scripts/welcome-film-audit.mjs",
    "completion:audit": "node scripts/v40-16-completion-audit.mjs",
    "anatomy:viewer": "node scripts/v40-17-anatomy-viewer-audit.mjs",
    "homepage:final": "node scripts/v40-18-homepage-final-audit.mjs",
    "anatomy:complete": "node scripts/v40-19-complete-atlas-audit.mjs",
    "anatomy:integrated": "node scripts/v40-20-integrated-scroll-atlas-audit.mjs",
    "layout:polish": "node scripts/v40-22-final-layout-audit.mjs",
    "layout:v40-21": "node scripts/v40-21-layout-polish-audit.mjs",
    "framing:polish": "node scripts/v40-23-framing-density-audit.mjs",
    "content:cleanup": "node scripts/v40-24-content-architecture-audit.mjs",
    "reading:polish": "node scripts/v40-25-reading-flow-audit.mjs",
    "navigation:final": "node scripts/v40-26-inline-navigation-audit.mjs",
    "anatomy:order": "node scripts/v40-28-testicular-final-audit.mjs",
    "anatomy:microplastics": "node scripts/v40-33-system-aware-microplastic-flow-audit.mjs",
    "anatomy:flow": "node scripts/v40-33-system-aware-microplastic-flow-audit.mjs",
    "release:audit": "npm run prepare:podcast-artwork && node scripts/v40-37-owner-review-audit.mjs && node scripts/v40-19-complete-atlas-audit.mjs && node scripts/podcast-tedx-audit.mjs",
    "podcast:launch-audit": "npm run prepare:podcast-artwork && node scripts/podcast-tedx-audit.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^9.7.0",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.6",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cloudflare": "4.92.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "Say No to Plastic"
}
